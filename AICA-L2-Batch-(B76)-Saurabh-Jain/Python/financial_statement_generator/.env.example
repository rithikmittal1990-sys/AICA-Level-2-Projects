# Application
APP_NAME="Financial Statement Generator"
APP_VERSION=0.1.0
DEBUG=false

# Directories (absolute or relative to the project root)
INPUT_DIR=input
REFERENCE_DIR=reference
TEMPLATE_DIR=templates
OUTPUT_DIR=output

# Filenames
TEMPLATE_FILENAME=Financial Statements_Sample.xlsx
REFERENCE_FILENAME=ICAI_GN_Div_I_Sch_III.pdf

# OCR fallback (used only when a page has little or no native text)
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=200

# Configurable Excel field map (source → Schedule III → sheet/cell)
MAPPING_CONFIG_PATH=app/mapping/excel_field_map.json

# Mappings below this confidence must be approved or rejected before Excel is generated
REVIEW_CONFIDENCE_THRESHOLD=0.85
